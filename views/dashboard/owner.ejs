<% layout('/layouts/boilerplate') -%>

<div class="row">
  <div class="col-lg-11 mx-auto">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Owner Dashboard</h3>
        <p class="text-muted mb-0">Manage all incoming booking inquiries</p>
      </div>
      <a href="/listings/new" class="btn btn-primary">+ Add New PG</a>
    </div>

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="stat-card text-center p-3 rounded-3 bg-warning bg-opacity-10 border border-warning">
          <h3 class="fw-bold text-warning mb-0"><%= pending.length %></h3>
          <small class="text-muted">Pending</small>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card text-center p-3 rounded-3 bg-success bg-opacity-10 border border-success">
          <h3 class="fw-bold text-success mb-0"><%= approved.length %></h3>
          <small class="text-muted">Approved</small>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card text-center p-3 rounded-3 bg-primary bg-opacity-10 border border-primary">
          <h3 class="fw-bold text-primary mb-0"><%= paid.length %></h3>
          <small class="text-muted">Confirmed (Paid)</small>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card text-center p-3 rounded-3 bg-danger bg-opacity-10 border border-danger">
          <h3 class="fw-bold text-danger mb-0"><%= rejected.length %></h3>
          <small class="text-muted">Rejected</small>
        </div>
      </div>
    </div>

    <!-- Inquiries Table -->
    <% if(inquiries.length === 0) { %>
      <div class="text-center py-5">
        <i class="fa-solid fa-inbox fa-3x text-muted mb-3"></i>
        <h5>No inquiries yet</h5>
        <p class="text-muted">When tenants send inquiries for your PGs, they will appear here.</p>
        <a href="/listings" class="btn btn-outline-primary">View My Listings</a>
      </div>
    <% } else { %>

      <!-- Pending First -->
      <% if(pending.length > 0) { %>
        <h5 class="fw-semibold mb-3 text-warning">
          <i class="fa-solid fa-clock me-2"></i>Pending Inquiries (<%= pending.length %>)
        </h5>
        <div class="row g-3 mb-4">
          <% for(let inq of pending) { %>
            <div class="col-12">
              <%- include('../includes/inquiry-card', { inq, showActions: true }) %>
            </div>
          <% } %>
        </div>
      <% } %>

      <!-- Approved -->
      <% if(approved.length > 0) { %>
        <h5 class="fw-semibold mb-3 text-success">
          <i class="fa-solid fa-check me-2"></i>Approved — Awaiting Payment (<%= approved.length %>)
        </h5>
        <div class="row g-3 mb-4">
          <% for(let inq of approved) { %>
            <div class="col-12">
              <%- include('../includes/inquiry-card', { inq, showActions: false }) %>
            </div>
          <% } %>
        </div>
      <% } %>

      <!-- Paid / Confirmed -->
      <% if(paid.length > 0) { %>
        <h5 class="fw-semibold mb-3 text-primary">
          <i class="fa-solid fa-circle-check me-2"></i>Confirmed Bookings (<%= paid.length %>)
        </h5>
        <div class="row g-3 mb-4">
          <% for(let inq of paid) { %>
            <div class="col-12">
              <%- include('../includes/inquiry-card', { inq, showActions: false }) %>
            </div>
          <% } %>
        </div>
      <% } %>

      <!-- Rejected -->
      <% if(rejected.length > 0) { %>
        <h5 class="fw-semibold mb-3 text-danger">
          <i class="fa-solid fa-times me-2"></i>Rejected (<%= rejected.length %>)
        </h5>
        <div class="row g-3 mb-4">
          <% for(let inq of rejected) { %>
            <div class="col-12">
              <%- include('../includes/inquiry-card', { inq, showActions: false }) %>
            </div>
          <% } %>
        </div>
      <% } %>

    <% } %>
  </div>
</div>
