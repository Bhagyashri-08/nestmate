<% layout('/layouts/boilerplate') -%>

<div class="row">
  <div class="col-lg-8 offset-lg-2">

    <a href="/listings" class="btn btn-outline-secondary btn-sm mb-3">
      <i class="fa-solid fa-arrow-left"></i> Back to listings
    </a>

    <img src="<%= listing.image %>" class="img-fluid rounded-3 mb-4 show-hero-img" alt="PG Image">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
      <div>
        <h3 class="fw-bold mb-1"><%= listing.title %></h3>
        <p class="text-muted mb-0"><i class="fa-solid fa-location-dot"></i> <%= listing.locality %>, <%= listing.city %></p>
      </div>
      <div class="text-end">
        <h4 class="fw-bold text-primary mb-0">&#8377;<%= listing.rent.toLocaleString("en-IN") %></h4>
        <small class="text-muted">per month</small>
      </div>
    </div>

    <div class="d-flex gap-2 flex-wrap mb-4">
      <span class="badge bg-primary"><%= listing.pgType %></span>
      <span class="badge bg-secondary"><%= listing.roomType %> Sharing</span>
      <% for(let amenity of listing.amenities) { %>
        <span class="badge bg-light text-dark border"><%= amenity %></span>
      <% } %>
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <h6 class="fw-semibold mb-2">About this PG</h6>
        <p class="mb-0"><%= listing.description %></p>
      </div>
    </div>

    <div class="card mb-4 border-primary">
      <div class="card-body">
        <h6 class="fw-semibold mb-2"><i class="fa-solid fa-user-circle text-primary me-2"></i>Posted by</h6>
        <p class="mb-1"><strong><%= listing.owner.username %></strong></p>
        <% if(currentUser) { %>
          <p class="mb-0 text-muted"><i class="fa-solid fa-envelope me-1"></i><%= listing.owner.email %></p>
        <% } else { %>
          <p class="mb-0 text-muted"><a href="/login">Login</a> to see contact & send inquiry</p>
        <% } %>
      </div>
    </div>

    <% if(currentUser && currentUser.role === "tenant") { %>
      <div class="card mb-4 border-success">
        <div class="card-header bg-success text-white fw-semibold">
          <i class="fa-solid fa-paper-plane me-2"></i>Send Booking Inquiry
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3">Fill this form to express your interest. After owner approves, pay Rs.500 token to confirm.</p>
          <form method="post" action="/inquiries/<%= listing._id %>" novalidate class="needs-validation">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Your Full Name *</label>
                <input name="tenantName" type="text" class="form-control" placeholder="e.g. Bhagyashri Patil" required>
                <div class="invalid-feedback">Name is required.</div>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Phone Number *</label>
                <input name="tenantPhone" type="tel" class="form-control" placeholder="e.g. 9876543210" required pattern="[0-9]{10}">
                <div class="invalid-feedback">Valid 10-digit number required.</div>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Expected Move-in Date *</label>
                <input name="moveInDate" type="date" class="form-control" required min="<%= new Date().toISOString().split('T')[0] %>">
                <div class="invalid-feedback">Move-in date is required.</div>
              </div>
              <div class="col-12">
                <label class="form-label fw-semibold">Message to Owner</label>
                <textarea name="message" class="form-control" rows="2" placeholder="Any specific requirements..."></textarea>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-success"><i class="fa-solid fa-paper-plane me-1"></i>Send Inquiry</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    <% } %>

    <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>
      <div class="d-flex gap-2 mb-5">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning"><i class="fa-solid fa-pen-to-square"></i> Edit</a>
        <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
          <button class="btn btn-danger" onclick="return confirm('Delete this listing?')"><i class="fa-solid fa-trash"></i> Delete</button>
        </form>
      </div>
    <% } %>

  </div>
</div>
